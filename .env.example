# === API Keys ===
GEMINI_API_KEY=your_gemini_api_key_here

# === VLM Settings ===
VLM_MODE=api                    # api | local
VLM_MODEL_NAME=gemini-1.5-flash # gemini-1.5-flash | gemini-1.5-pro | Qwen2.5-VL-3B
VLM_TEMPERATURE=0.2
VLM_MAX_TOKENS=4096

# === Local Model Paths ===
QWEN_MODEL_PATH=Qwen/Qwen2.5-VL-3B-Instruct  # HuggingFace ID or local path
GLM_OCR_MODEL_PATH=zai-org/GLM-OCR             # HuggingFace ID or ./models/glm-ocr
TTS_MODEL_PATH=./models/vitts

# === TTS Settings ===
TTS_ENGINE=f5-tts               # f5-tts | vixtts
TTS_SAMPLE_RATE=22050
TTS_SPEED=1.0

# === Processing ===
CHUNK_DURATION_SEC=45
MAX_CONCURRENT_CHUNKS=4
SCENE_THRESHOLD=27.0

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === Data Paths ===
RAW_VIDEO_DIR=./data/raw
REFERENCE_AUDIO_DIR=./data/reference_audio
OUTPUT_DIR=./data/outputs
PROCESSED_DIR=./data/processed
