# === API Keys ===
GEMINI_API_KEY=your_gemini_api_key_here

# === VLM Settings ===
VLM_MODE=api                    # api | local
VLM_MODEL_NAME=gemini-1.5-flash # gemini-1.5-flash | gemini-1.5-pro | Qwen3.5-0.8B | Qwen2.5-VL-3B
VLM_TEMPERATURE=0.2
VLM_MAX_TOKENS=4096

# === Local Model Paths ===
QWEN_MODEL_PATH=Qwen/Qwen3.5-2B                # Default: Qwen3.5-2B (~4GB VRAM)
# QWEN_MODEL_PATH=Qwen/Qwen3.5-0.8B             # Lite: Qwen3.5-0.8B (~1.6GB VRAM)
# QWEN_MODEL_PATH=Qwen/Qwen2.5-VL-3B-Instruct  # Legacy: Qwen2.5-VL-3B (~6GB VRAM)
GLM_OCR_MODEL_PATH=zai-org/GLM-OCR             # HuggingFace ID or ./models/glm-ocr
TTS_MODEL_PATH=./models/vitts

# === TTS Settings (VieNeu-TTS v2 Turbo) ===
TTS_ENGINE=vieneu                                     # vieneu | f5-tts | vixtts
TTS_BACKBONE_REPO=                                    # leave empty to use vieneu SDK defaults (recommended)
TTS_BACKBONE_DEVICE=cuda                              # cuda | cpu
TTS_CODEC_DEVICE=cpu                                  # cpu (small ONNX, saves VRAM) | cuda
TTS_VIENEU_MODE=turbo                                 # turbo (default, ONNX) | standard (needs neucodec pkg) | remote
TTS_SAMPLE_RATE=24000                                 # VieNeu native: 24 kHz
TTS_HF_TOKEN=                                         # HuggingFace token (required for VieNeu)

# === External Tools ===
# Tùy chọn: đường dẫn tuyệt đối tới rubberband.exe nếu không có trong PATH.
# Để trống thì dùng "rubberband" trên PATH.
RUBBERBAND_PATH=

# === Processing ===
CHUNK_DURATION_SEC=45
CHUNK_OVERLAP_SEC=5               # Overlap between chunks (prevents boundary context loss)
MAX_CONCURRENT_CHUNKS=4
SCENE_THRESHOLD=27.0
SSIM_THRESHOLD=0.85               # Frame dedup threshold (0.80=aggressive, 0.85=balanced, 0.95=minimal)

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true

# === Data Paths ===
RAW_VIDEO_DIR=./data/raw
REFERENCE_AUDIO_DIR=./data/reference_audio
OUTPUT_DIR=./data/outputs
PROCESSED_DIR=./data/processed

# === M1 Entry Retiming ===
# Vietnamese speaking rate estimate (chars/sec) for EntryRetimer slot sizing.
M1_VI_CHARS_PER_SEC=15.0
# Fraction of chunk duration that subtitle slots fill (rest is gap budget).
M1_CHUNK_FILL_RATIO=0.95

# === M3 Audio Alignment ===
# Max TTS speed-up before AudioAligner slips next segment.
M3_MAX_SPEEDUP=1.25
# Min gap between subtitles and between aligned audio segments.
M3_MIN_GAP_SEC=0.1

# === Pipeline mode (M4) ===
# 'vlm' (default, today's pipeline) or 'ocr' (GLM-OCR caption timing + VLM translation).
PIPELINE_MODE=vlm

# === OCR pipeline tuning (only used when PIPELINE_MODE=ocr) ===
# Frame sampling rate for caption OCR (frames per second). 2.0 = every 0.5s.
OCR_SAMPLE_FPS=2.0
# Fraction of frame height (from bottom) sent to GLM-OCR. 0.10 isolates a
# typical narration band and excludes footer/brand text. If your video puts the
# narration higher in the frame, raise this to 0.15-0.22.
CAPTION_BAND_RATIO=0.10
# SequenceMatcher ratio threshold for "same caption" — handles OCR jitter.
CAPTION_DEDUP_RATIO=0.85
# Drop OCR-derived caption segments shorter than this (seconds).
CAPTION_MIN_DURATION_SEC=0.3
# Merge adjacent narration fragments whose gap is at most this (seconds).
CAPTION_MERGE_MAX_GAP_SEC=0.3
# Cap on combined English chars when merging adjacent segments.
CAPTION_MERGE_MAX_CHARS=100
# Extend each entry's end_time by up to this many seconds (capped by next start).
CAPTION_EXTEND_END_SEC=0.5
